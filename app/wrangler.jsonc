{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maple-closet",
  "main": "src/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "maple-closet.builtby.win",
      "custom_domain": true
    }
  ]
}
